{
  "name": "vitalcap-server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API server for VitalCap.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "check": "node --check src/*.js && node --check scripts/*.js && node --check test/*.test.js",
    "test": "node --test"
  }
}
